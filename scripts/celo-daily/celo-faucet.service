[Unit]
Description=Claim Celo Sepolia testnet tokens
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=devspace
EnvironmentFile=/home/devspace/projects/testnet-wallet-tools/.env
EnvironmentFile=/etc/celo-faucet-beneficiary
ExecStart=/usr/bin/python3 -I /usr/local/libexec/claim-celo-faucet.py
StateDirectory=celo-faucet
StateDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
TimeoutStartSec=4min
